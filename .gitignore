# Local scratch + build artifacts (never commit)
*.zip

# Never commit secrets or local env files
.env
.env.local
*.pem
*.key

# wrangler's local cache (account id, page state) — local tooling only
/.wrangler/

# deploy staging output (built by scripts/deploy.mjs)
/dist/

# Pages Functions staged at the project root during deploy only
# (source of truth is chiitech/functions — leading / keeps that unaffected)
/functions/
